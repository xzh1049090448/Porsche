{
  "version": "v1",
  "status": "approved_contract_pending_implementation",
  "pricing": {
    "currency": "USD",
    "unit": "million_tokens",
    "components": ["input", "output"],
    "wire_type": "decimal_string",
    "fractional_digits_maximum": 8,
    "minimum": "0",
    "maximum": "999999999999.99999999",
    "safe_examples": {
      "input_price_usd_per_million_tokens": "12.34567890",
      "output_price_usd_per_million_tokens": "3.21000000"
    },
    "billing_semantics": "references_only_no_automatic_charge"
  },
  "roles": {
    "anonymous": "public_read_only",
    "root": "authenticated_root_role_required"
  },
  "public_request_headers": {},
  "public_response_headers": {
    "ETag": "required",
    "X-Public-Release-Version": "required_release_version",
    "Cache-Control": "public_max_age_60_stale_while_revalidate_300"
  },
  "admin_request_headers": {
    "Authorization": "required_authenticated_root_session_or_bearer"
  },
  "admin_verified_action_request_headers": {
    "Authorization": "required_authenticated_root_session_or_bearer",
    "X-Action-Ticket": "required_single_use_action_ticket"
  },
  "admin_publish_request_headers": {
    "Authorization": "required_authenticated_root_session_or_bearer",
    "Idempotency-Key": "required_exactly_once_unique_per_root_and_operation",
    "X-Action-Ticket": "required_single_use_action_ticket"
  },
  "admin_response_headers": {
    "Cache-Control": "no-store",
    "X-Request-ID": "required_non_empty"
  },
  "admin_preview_response_headers": {
    "Cache-Control": "no-store",
    "X-Request-ID": "required_non_empty",
    "X-Robots-Tag": "noindex_nofollow"
  },
  "body_rules": {
    "mutation": "one_exact_json_object_no_unknown_duplicate_or_trailing_fields",
    "forbidden_body_fields": ["action_ticket"],
    "rejection": "400_invalid_public_content_pricing_request"
  },
  "mutation_requirements": {
    "optimistic_concurrency_field": "expected_revision",
    "expected_revision_routes": [
      "PATCH /admin/v2/public-models/{guid}",
      "POST /admin/v2/public-models/{guid}/activate",
      "POST /admin/v2/public-models/{guid}/deactivate",
      "DELETE /admin/v2/public-models/{guid}",
      "PUT /admin/v2/public-pricing/draft",
      "POST /admin/v2/public-pricing/validate",
      "POST /admin/v2/public-pricing/publish",
      "POST /admin/v2/public-pricing/releases/{guid}/restore",
      "PUT /admin/v2/public-content/draft",
      "POST /admin/v2/public-content/validate",
      "POST /admin/v2/public-content/publish",
      "POST /admin/v2/public-content/releases/{guid}/restore"
    ],
    "idempotency_key_routes": [
      "POST /admin/v2/public-pricing/publish",
      "POST /admin/v2/public-pricing/releases/{guid}/restore",
      "POST /admin/v2/public-content/publish",
      "POST /admin/v2/public-content/releases/{guid}/restore"
    ],
    "action_ticket_header_routes": [
      "DELETE /admin/v2/public-models/{guid}",
      "POST /admin/v2/public-pricing/publish",
      "POST /admin/v2/public-pricing/releases/{guid}/restore",
      "POST /admin/v2/public-content/publish",
      "POST /admin/v2/public-content/releases/{guid}/restore"
    ],
    "idempotency_header": "Idempotency-Key required_exactly_once_unique_per_root_and_operation"
  },
  "model_lookup_semantics": {
    "unknown_or_never_published": "404",
    "previously_published_inactive_or_deleted": "410"
  },
  "notifications": {
    "delivery": "in_app_only",
    "types": ["published_price_below_upstream", "upstream_missing", "automatic_inactivation", "upstream_reappearance", "catalog_sync_failure", "price_not_comparable", "renderer_failure"],
    "receipt_scope": "independent_read_and_acknowledgement_per_root"
  },
  "schemas": {
