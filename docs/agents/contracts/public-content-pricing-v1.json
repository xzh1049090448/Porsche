    "AdminModelListResponse": {"type": "object", "required": ["items", "page", "page_size", "total"], "properties": {"items": {"type": "array", "items": {"type": "object", "$ref": "PublicModelAdmin"}}, "page": {"type": "integer"}, "page_size": {"type": "integer"}, "total": {"type": "integer"}}},
    "CreatePublicModelRequest": {"type": "object", "required": ["upstream_model_id", "model_key", "display_name", "provider", "capabilities", "context_window"], "properties": {"upstream_model_id": {"type": "string"}, "model_key": {"type": "string"}, "display_name": {"type": "string"}, "provider": {"type": "string"}, "capabilities": {"type": "array", "items": {"type": "string"}}, "context_window": {"type": "integer"}, "input_price_usd_per_million_tokens": {"type": "string", "nullable": true, "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$", "minimum": "0", "maximum": "999999999999.99999999"}, "output_price_usd_per_million_tokens": {"type": "string", "nullable": true, "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$", "minimum": "0", "maximum": "999999999999.99999999"}}},
    "UpdatePublicModelRequest": {"type": "object", "required": ["expected_revision"], "properties": {"expected_revision": {"type": "integer", "minimum": 1}, "display_name": {"type": "string"}, "provider": {"type": "string"}, "capabilities": {"type": "array", "items": {"type": "string"}}, "context_window": {"type": "integer"}, "input_price_usd_per_million_tokens": {"type": "string", "nullable": true, "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$", "minimum": "0", "maximum": "999999999999.99999999"}, "output_price_usd_per_million_tokens": {"type": "string", "nullable": true, "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$", "minimum": "0", "maximum": "999999999999.99999999"}}},
