    "PublicModelVisible": {"type": "object", "required": ["model_key", "display_name", "provider", "capabilities", "context_window", "input_price_usd_per_million_tokens", "output_price_usd_per_million_tokens", "price_visibility", "release_version"], "properties": {"model_key": {"type": "string"}, "display_name": {"type": "string"}, "provider": {"type": "string"}, "capabilities": {"type": "array", "items": {"type": "string"}}, "context_window": {"type": "integer"}, "input_price_usd_per_million_tokens": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$", "minimum": "0", "maximum": "999999999999.99999999"}, "output_price_usd_per_million_tokens": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$", "minimum": "0", "maximum": "999999999999.99999999"}, "price_visibility": {"type": "string", "enum": ["visible"]}, "release_version": {"type": "integer"}}},
    "PublicModelRedacted": {"type": "object", "required": ["model_key", "display_name", "provider", "capabilities", "context_window", "price_visibility", "release_version"], "properties": {"model_key": {"type": "string"}, "display_name": {"type": "string"}, "provider": {"type": "string"}, "capabilities": {"type": "array", "items": {"type": "string"}}, "context_window": {"type": "integer"}, "price_visibility": {"type": "string", "enum": ["authenticated_only"]}, "release_version": {"type": "integer"}}},
    "PublicModelItem": {"type": "union", "one_of": ["PublicModelVisible", "PublicModelRedacted"]},
    "PublicModelAdmin": {"type": "object", "required": ["guid", "model_key", "upstream_model_id", "display_name", "provider", "capabilities", "context_window", "input_price_usd_per_million_tokens", "output_price_usd_per_million_tokens", "status", "revision", "last_upstream_check_at"], "properties": {"guid": {"type": "string"}, "model_key": {"type": "string"}, "upstream_model_id": {"type": "string"}, "display_name": {"type": "string"}, "provider": {"type": "string"}, "capabilities": {"type": "array", "items": {"type": "string"}}, "context_window": {"type": "integer"}, "input_price_usd_per_million_tokens": {"type": "string", "nullable": true, "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$", "minimum": "0", "maximum": "999999999999.99999999"}, "output_price_usd_per_million_tokens": {"type": "string", "nullable": true, "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$", "minimum": "0", "maximum": "999999999999.99999999"}, "status": {"type": "string", "enum": ["draft", "active", "inactive"]}, "revision": {"type": "integer"}, "last_upstream_check_at": {"type": "integer", "nullable": true}}},
    "SiteReleaseResponse": {"type": "object", "required": ["content_release_version", "price_release_version", "price_visibility"], "properties": {"content_release_version": {"type": "integer"}, "price_release_version": {"type": "integer"}, "price_visibility": {"type": "string", "enum": ["visible", "authenticated_only"]}}},
    "PublishedDocumentResponse": {"type": "object", "required": ["document", "release_version"], "properties": {"document": {"type": "string"}, "release_version": {"type": "integer"}}},
    "PublicModelsListRequest": {"type": "object", "properties": {"search": {"type": "string"}, "provider": {"type": "string"}, "capability": {"type": "string"}, "page": {"type": "integer"}, "page_size": {"type": "integer"}}},
