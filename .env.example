# 运行环境: development | staging | production
APP_ENV=development

# 服务监听
HOST=0.0.0.0
PORT=8000

# 仅接受这些 HTTP Host（逗号分隔）；生产环境必须保留正式域名。
ALLOWED_HOSTS=aiportcloud.com

# 管理接口 Bearer Token（生产必须使用非默认且不与 JWT/HMAC/Metrics 复用的值）
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Prometheus Metrics Token（生产必须独立配置，不能回退复用 ADMIN_TOKEN）
METRICS_TOKEN=change-me-to-a-distinct-random-secret

# JWT 密钥
JWT_SECRET_KEY=change-me-jwt-secret-for-dev-only

# 一期用户名密码认证与可撤销会话。生产环境必须配置 Redis、非默认 JWT/HMAC
# 密钥以及至少一个 HTTPS 可信 Origin；AUTH_TRUSTED_ORIGINS 以逗号分隔。
REGISTER_ENABLED=true
PASSWORD_REGISTER_ENABLED=true
PASSWORD_LOGIN_ENABLED=true
SESSION_ACCESS_MINUTES=15
SESSION_DAYS=30
SESSION_MAX_ACTIVE=50
SESSION_ISSUE_LIMIT_24H=100
REFRESH_REPLAY_SECONDS=30
AUTH_HMAC_KEY=change-me-auth-hmac-key-for-dev-only
AUTH_TRUSTED_ORIGINS=https://app.example.com
# 仅首次部署引导 Root 时同时设置以下两项；引导成功后必须从生产环境删除。
ROOT_BOOTSTRAP_USERNAME=
ROOT_BOOTSTRAP_PASSWORD=

# 唯一白牌上游（请使用真实值，勿提交 .env）
# 可选值：cn（国内）或 global（海外）
UPSTREAM_REGION=cn
JIEKOU_API_KEY=replace-with-jiekou-api-key
# 逗号分隔的精确模型 ID；仅这些模型会从上游目录中对外暴露和调用。
JIEKOU_ALLOWED_MODELS=zai-org/glm-5.1,deepseek/deepseek-v4-pro
# 或使用一个或多个显式 re: RE2 模式；本示例允许所有安全的上游模型 ID：
# JIEKOU_ALLOWED_MODELS=re:^.+$
# re: 仅适用于此全局 allowlist；用户和 Gateway Token 的 allowed_models 始终是精确 ID。
# Only honor X-Forwarded-For when the direct peer matches one of these CIDRs.
# Set this to the actual source IP or CIDR Nginx uses when connecting to the
# application container; do not copy the Docker gateway from another host.
# TRUST_PROXY_HEADERS=true without this value remains safe and ignores headers.
TRUSTED_PROXY_CIDRS=

# 数据库（仅支持 MySQL 8；必须在启动前执行 go run ./cmd/migrate up）
DATABASE_URL=mysql://platform:platform@127.0.0.1:3306/platform
# Python SQLAlchemy URL 也可使用：mysql+aiomysql://platform:platform@mysql:3306/platform
SNOWFLAKE_NODE_ID=0

# Redis（认证会话、限流、验证码、用量统计；生产认证必填）
REDIS_URL=

# 固定账号密码登录（示例仅限 development；生产必须关闭且不得保留示例凭据）
FIXED_LOGIN_ENABLED=true
FIXED_LOGIN_PHONE=13800138000
FIXED_LOGIN_PASSWORD=Porsche@2026

# SMS 开发模式
SMS_DEV_MODE=true

# 模拟支付
BILLING_ALLOW_MOCK_PAYMENT=false

# 模型数据分析管理员手机号（逗号分隔）
# ANALYTICS_ADMIN_PHONES=13800138000

# 日志级别
LOG_LEVEL=INFO

# 上游超时（秒）
UPSTREAM_TIMEOUT_SECONDS=120
