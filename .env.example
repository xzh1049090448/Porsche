# 运行环境: development | staging | production
APP_ENV=development

# 服务监听
HOST=0.0.0.0
PORT=8000

# 仅接受这些 HTTP Host（逗号分隔）；生产环境必须保留正式域名。
ALLOWED_HOSTS=aiportcloud.com

# 管理接口 Bearer Token
ADMIN_TOKEN=change-me-to-a-long-random-secret

# JWT 密钥
JWT_SECRET_KEY=change-me-jwt-secret-for-dev-only

# 唯一白牌上游（请使用真实值，勿提交 .env）
# 可选值：cn（国内）或 global（海外）
UPSTREAM_REGION=cn
JIEKOU_API_KEY=replace-with-jiekou-api-key
# 逗号分隔；仅这些模型会从上游目录中对外暴露和调用。
JIEKOU_ALLOWED_MODELS=model-a,model-b
# Only honor X-Forwarded-For when the direct peer matches one of these CIDRs.
# Set this to the actual source IP or CIDR Nginx uses when connecting to the
# application container; do not copy the Docker gateway from another host.
# TRUST_PROXY_HEADERS=true without this value remains safe and ignores headers.
TRUSTED_PROXY_CIDRS=

# 数据库（生产时与 Python 版共用同一个 MySQL DATABASE_URL）
DATABASE_URL=sqlite://./data/platform.db
# Python 的 SQLAlchemy URL 可直接复用：
# DATABASE_URL=mysql+aiomysql://platform:platform@mysql:3306/platform

# Redis（限流、验证码、用量统计）
REDIS_URL=

# 向量检索持久化目录
CHROMA_PERSIST_DIR=./data/chroma

# 数据集上传目录
DATASET_UPLOAD_DIR=./data/uploads

# 固定账号密码登录
FIXED_LOGIN_ENABLED=true
FIXED_LOGIN_PHONE=13800138000
FIXED_LOGIN_PASSWORD=Porsche@2026

# SMS 开发模式
SMS_DEV_MODE=true

# 模拟支付
BILLING_ALLOW_MOCK_PAYMENT=false

# 模型数据分析管理员手机号（逗号分隔）
# ANALYTICS_ADMIN_PHONES=13800138000

# 日志级别
LOG_LEVEL=INFO

# 上游超时（秒）
UPSTREAM_TIMEOUT_SECONDS=120
